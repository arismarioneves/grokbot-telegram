# Disable directory listing
Options -Indexes

# Deny direct HTTP access to configuration files, logs, documentation, and Git metadata
<FilesMatch "^(config(\.example|\.exemplo)?\.php|.*\.log|README\.md|\.git.*)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
